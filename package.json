{
  "name": "@itsaorg/dbms-base",
  "version": "0.0.0",
  "description": "Zero-dependency TypeScript contracts for Itsa DBMS stores, queries, transactions, and buffer boundaries.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty",
    "build": "tsc --project tsconfig.json --pretty",
    "format": "prettier --config configs/.prettierrc.json --ignore-path configs/prettierignore --write .",
    "format:check": "prettier --config configs/.prettierrc.json --ignore-path configs/prettierignore --check .",
    "lint": "eslint . --config configs/eslint.config.js",
    "lint:fix": "eslint . --config configs/eslint.config.js --fix",
    "test": "vitest --config configs/vitest.config.ts",
    "docs": "typedoc --options configs/typedoc.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --config configs/.prettierrc.json --ignore-path configs/prettierignore --write",
    "*.ts": "eslint --config configs/eslint.config.js --fix"
  }
}
